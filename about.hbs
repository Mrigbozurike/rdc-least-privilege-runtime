<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<title>Third-party licenses — rdc</title>
<style>body{font-family:system-ui,sans-serif;max-width:60em;margin:2em auto;padding:0 1em}pre{white-space:pre-wrap;background:#f4f4f4;padding:1em;border-radius:6px}</style>
</head><body>
<h1>Third-party licenses</h1>
<p>rdc is licensed under the GNU AGPL-3.0-or-later. It links the following third-party crates, whose license texts are reproduced below as their licenses require.</p>
<h2>Overview</h2><ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<h3>Used by</h3><ul>{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
</body></html>
